# Copy to .env (never commit .env)
LLM_PROVIDER=ollama
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_VISION_MODEL=gemma3:4b      # figure captioning at ingestion (ollama pull gemma3:4b)
# OLLAMA_NUM_THREAD=2              # cap CPU on laptops without a GPU
# OLLAMA_KEEP_ALIVE=60

# Emerging-treatment data: synthetic registry (offline) or live ClinicalTrials.gov API v2 (no key needed)
TRIALS_SOURCE=synthetic
# LIVE_MAX_TRIALS=40

# Retrieval
# TOP_K=6
# BRIEFING_K=6
# MIN_RELEVANCE=0.50

# LangSmith monitoring (optional)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=condition-briefing
# LANGSMITH_HIDE_INPUTS=true

# RAGAS judge (default: local Ollama; llama3.2-judge if created from tools/ollama/Modelfile.judge)
# RAGAS_JUDGE_MODEL=llama3.2
# RAGAS_JUDGE_PROVIDER=openai   # + OPENAI_API_KEY

# AWS Bedrock (optional): pip install langchain-aws
# LLM_PROVIDER=bedrock
# EMBEDDING_PROVIDER=bedrock
# BEDROCK_MODEL_ID=
