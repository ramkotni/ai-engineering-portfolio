# Copy to .env (never commit .env)
LLM_PROVIDER=ollama
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_NUM_THREAD=2          # cap CPU on laptops without a GPU
# OLLAMA_KEEP_ALIVE=60

# Retrieval
# SEARCH_TOP_K=6
# MIN_RELEVANCE=0.50

# LangSmith monitoring (optional)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=payment-ops-intelligence
# LANGSMITH_HIDE_INPUTS=true

# RAGAS judge (default: local Ollama via its OpenAI-compatible API)
# RAGAS_JUDGE_MODEL=llama3.2
# RAGAS_JUDGE_PROVIDER=openai   # + OPENAI_API_KEY to use an OpenAI judge instead

# AWS Bedrock (optional): pip install langchain-aws
# LLM_PROVIDER=bedrock
# EMBEDDING_PROVIDER=bedrock
# BEDROCK_MODEL_ID=
