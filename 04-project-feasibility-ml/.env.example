# Copy to .env (never commit .env)
# Model training
# CV_FOLDS=5
# INTERPRETABILITY_TOLERANCE=0.02   # choose LogisticRegression if within this CV AUC of the best model
# DECISION_THRESHOLD=0.5

# LLM advisor (optional)
OLLAMA_CHAT_MODEL=llama3.2
# OLLAMA_NUM_THREAD=2

# LangSmith (traces the advisor)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=project-feasibility-ml
