# ---------- Local prototype (default): Ollama ----------
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Resource controls (CPU-only laptops)
# OLLAMA_NUM_THREAD=2        # cores used for inference; leave unset to use all cores
# OLLAMA_KEEP_ALIVE=60       # seconds to keep the model in RAM after the last call (0 = immediately)
# OLLAMA_NUM_CTX=4096        # context window; larger = more RAM
# OLLAMA_NUM_PREDICT=512     # max answer tokens

# ---------- AWS Bedrock ----------
# LLM_PROVIDER=bedrock
# EMBEDDING_PROVIDER=bedrock
# AWS_REGION=us-east-1
# Claude model ID or cross-region inference profile ID enabled in your account
# (aws bedrock list-inference-profiles --region us-east-1 --query "inferenceProfileSummaries[].inferenceProfileId")
# BEDROCK_MODEL_ID=
# BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# ---------- Behaviour ----------
# TOP_K=5
# MIN_RELEVANCE=0.55
# ROUTE_CONFIDENCE_THRESHOLD=0.6
# GROUNDING_CHECK=true
# MAX_GENERATION_ATTEMPTS=2   # set 1 on CPU-only laptops for faster answers

# ---------- Chunking (changing these triggers an automatic index rebuild) ----------
# CHUNK_SIZE=900             # characters (~225 tokens)
# CHUNK_OVERLAP=120          # only for paragraphs longer than CHUNK_SIZE
# TABLE_MAX_CHARS=2500       # tables up to this size stay whole; larger ones split by rows

# ---------- Guardrails ----------
# MAX_QUESTION_CHARS=1000
# NUMERIC_GROUNDING_CHECK=true
# BEDROCK_GUARDRAIL_ID=      # Amazon Bedrock Guardrail (content filters, denied topics, PII)
# BEDROCK_GUARDRAIL_VERSION=DRAFT

# ---------- Monitoring ----------
# AUDIT_LOG_PATH=logs/audit.jsonl   # empty value disables the local audit log
# LangSmith tracing + feedback + experiments
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=plant-assist
# LANGSMITH_HIDE_INPUTS=true        # keep document text / questions out of LangSmith
# LANGSMITH_HIDE_OUTPUTS=true
