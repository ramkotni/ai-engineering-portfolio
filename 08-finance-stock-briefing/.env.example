# Copy to .env (never commit .env)
LLM_PROVIDER=ollama
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_NUM_THREAD=2              # cap CPU on laptops without a GPU
# OLLAMA_KEEP_ALIVE=60

# Market data and filings: synthetic (offline, fictional NWRB / HLXB) or live (Yahoo Finance chart API + SEC EDGAR)
DATA_SOURCE=synthetic
# SEC requires a descriptive User-Agent with contact details for EDGAR requests (live filings and financials):
# SEC_USER_AGENT=Your Company your.name@example.com
# LIVE_SECTION_CHARS=15000          # cap per filing section indexed in live mode

# Retrieval
# TOP_K=6
# SECTION_K=4
# BM25_WEIGHT=2.0                 # BM25 weight in reciprocal rank fusion (tuned with eval/ragas_eval.py --optimize)

# LangSmith monitoring (optional)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=stock-briefing

# RAGAS judge (default: local Ollama)
# RAGAS_JUDGE_MODEL=llama3.2

# AWS Bedrock (optional): pip install langchain-aws
# LLM_PROVIDER=bedrock
# EMBEDDING_PROVIDER=bedrock
# BEDROCK_MODEL_ID=
