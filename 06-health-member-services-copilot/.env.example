# ============ Local (default): Ollama + Chroma ============
APP_ENV=local
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
VECTOR_BACKEND=chroma
CHECKPOINTER=memory

# ============ AWS: Amazon Bedrock ============
# APP_ENV=aws
# LLM_PROVIDER=bedrock
# AWS_REGION=us-east-1
# Use the newest Claude inference profile enabled in your account/region:
# BEDROCK_CHAT_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
# VECTOR_BACKEND=chroma            # or bedrock_kb (+ BEDROCK_KB_ID=...)
# BEDROCK_GUARDRAIL_ID=            # output of deploy/aws/create_guardrail.py
# BEDROCK_GUARDRAIL_VERSION=1

# ============ Agent tuning ============
RETRIEVAL_K=4
RELEVANCE_THRESHOLD=0.50
ENABLE_DOC_GRADING=true
ENABLE_GROUNDEDNESS_CHECK=true
# numeric (local 3B model) | llm | both (recommended with Bedrock Claude)
GROUNDEDNESS_MODE=numeric
MAX_QUERY_REWRITES=1
MAX_REGENERATIONS=1

# ============ Evaluation judge (ideally stronger than the model under test) ============
# EVAL_JUDGE_PROVIDER=bedrock
# EVAL_JUDGE_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# ============ API ============
# API_KEY=change-me
PORT=8080

# ============ Observability: LangSmith (optional) ============
# Get a key at https://smith.langchain.com (Settings > API Keys). app/observability.py
# exports these to os.environ at startup so LangChain/LangGraph trace automatically.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=evergreen-member-assist
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # EU region / self-hosted only
# LANGSMITH_AUTO_FEEDBACK=true                            # grounded / guardrail scores on every trace
# LANGSMITH_HIDE_INPUTS=true                              # strict PHI policy: no inputs in traces
# LANGSMITH_HIDE_OUTPUTS=true                             # ...and no outputs
